# ─────────────────────────────────────────────────────────────────────────────
# SiteLog Backend — Environment Variables
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────────────────────

# ── ML Inference Server (required) ────────────────────────────────────────────
# URL of the running MobileNetV2 Flask server.
# Start it locally with:
#   cd model_training && source venv/bin/activate && python inference_server.py
# In production, set this to the Railway deployment URL.
# Production: https://sitelog-ml.onrender.com
# Local:      http://localhost:5001
ML_SERVER_URL=http://localhost:5001

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=3001
