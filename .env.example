# ─────────────────────────────────────────────────────────────────────────────
# SiteLog Backend — Environment Variables
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Python MobileNetV2 Inference Server (PRIMARY — your trained model) ─────────
# Start the server before running the backend:
#   cd model_training
#   source venv/bin/activate
#   python inference_server.py
# The backend will call it automatically when a report photo is uploaded.
INFERENCE_URL=http://localhost:5001

# ── Claude Vision (OPTIONAL fallback — only used if Python server is down) ──────
# If the Python server is not running and this key is set, Claude claude-haiku-5-5
# is used as a fallback. Leave blank to skip and let reports stay 'pending'.
# Get key at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=3000
