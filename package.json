{
  "name": "sitelog-backend",
  "version": "1.0.0",
  "description": "SiteLog REST API — Node.js/Express + SQLite",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "seed": "node src/db/seed.js",
    "test": "jest --runInBand --forceExit --testTimeout=15000",
    "test:verbose": "jest --runInBand --forceExit --verbose --testTimeout=15000"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/src/__tests__/**/*.test.js"],
    "testTimeout": 15000
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^18.0.8",
    "express": "^4.18.2",
    "express-fileupload": "^1.4.3",
    "form-data": "^4.0.0",
    "node-fetch": "^2.7.0",
    "sql.js": "^1.15.1",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "nodemon": "^3.0.3",
    "supertest": "^7.3.2"
  }
}
